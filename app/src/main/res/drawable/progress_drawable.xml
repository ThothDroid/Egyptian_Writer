<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Progress bar background -->
    <item android:id="@android:id/background">
        <shape>
            <solid
                android:color="@color/l_colorPrimary" />
            <gradient
                android:angle="180"
                android:endColor="@color/l_backgroundDark"
                android:startColor="@color/l_backgroundDarker" />
            <corners
                android:radius="8dp" />
        </shape>
    </item>

    <!-- Progress bar progress -->
    <item android:id="@android:id/progress">
        <clip>
            <shape>
                <solid
                    android:color="@color/l_colorPrimary" />
                <gradient
                    android:angle="0"
                    android:endColor="@color/l_colorPrimaryDark"
                    android:startColor="@color/l_colorPrimary" />
                <corners
                    android:radius="8dp" />
            </shape>
        </clip>
    </item>

</layer-list>